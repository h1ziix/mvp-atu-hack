# Без этих переменных приложение работает с локальными демоданными.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional override. By default the app calls <SUPABASE_URL>/functions/v1/smart-input.
# DEEPSEEK_API_KEY and AI_SESSION_SECRET belong only in Supabase Edge Function Secrets.
EXPO_PUBLIC_SMART_INPUT_URL=
